# ==============================================================================
# KKN TRADER - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# Frontend Client URL (For CORS whitelist in production)
# Example: https://kkntrader.com or https://your-app.vercel.app
CLIENT_URL=https://kkntrader.com

# Database Connection (MongoDB Atlas in Production)
# Replace <username>, <password>, and <cluster-name> with your MongoDB Atlas credentials
# Example: mongodb+srv://kknadmin:YourStrongPassword@cluster0.abcde.mongodb.net/kkntrader?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kkntrader?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong 32+ character random string in production)
JWT_SECRET=kkn_super_secret_jwt_key_gold_institutional_production_2026
JWT_EXPIRE=30d

# Market Data API Keys (Optional - default high-speed realistic simulation runs automatically)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# AI Educational Assistant Configuration
# Options: offline_smart_engine | gemini | openai
AI_PROVIDER=offline_smart_engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# Initial Admin Credentials (Created automatically upon first startup seed)
ADMIN_NAME="KKN Master Trader"
ADMIN_EMAIL="admin@kkntrader.com"
ADMIN_PASSWORD="Admin@KKNTrader2026!"
